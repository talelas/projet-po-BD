<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="ui.controllers.SuppliersController" stylesheets="@../styles/styles.css">
    
    <!-- Top Bar -->
    <top>
        <HBox styleClass="top-bar" style="-fx-background-color: #FF9800; -fx-padding: 15;">
            <Label text="SUPPLIER MANAGEMENT" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="welcomeLabel" style="-fx-text-fill: white; -fx-font-size: 14px;"/>
            <Button fx:id="backButton" text="BACK TO DASHBOARD" style="-fx-background-color: #F57C00; -fx-text-fill: white;">
                <HBox.margin>
                    <Insets left="15"/>
                </HBox.margin>
            </Button>
        </HBox>
    </top>
    
    <!-- Center Content -->
    <center>
        <VBox spacing="10" style="-fx-padding: 20;">
            
            <!-- Toolbar -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="searchField" promptText="Search by name..." prefWidth="220"/>
                <Button fx:id="searchButton" text="Search" styleClass="button"/>
                <TextField fx:id="productSearchField" promptText="Search by product name..." prefWidth="220"/>
                <Button fx:id="searchByProductButton" text="Search by Product" styleClass="button"/>
                <Button fx:id="refreshButton" text="Refresh" styleClass="button"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="addButton" text="Add Supplier" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
                <Button fx:id="linkProductButton" text="Link Product" style="-fx-background-color: #03A9F4; -fx-text-fill: white;" disable="true"/>
                <Button fx:id="viewProductsButton" text="View Products" style="-fx-background-color: #9C27B0; -fx-text-fill: white;" disable="true"/>
            </HBox>
            
            <!-- Table -->
            <TableView fx:id="suppliersTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" prefWidth="60"/>
                    <TableColumn fx:id="nameColumn" text="Last Name" prefWidth="150"/>
                    <TableColumn fx:id="prenomColumn" text="First Name" prefWidth="150"/>
                    <TableColumn fx:id="emailColumn" text="Email" prefWidth="220"/>
                    <TableColumn fx:id="phoneColumn" text="Phone" prefWidth="150"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
            
            <!-- Action Buttons -->
            <HBox spacing="10" alignment="CENTER">
                <Button fx:id="editButton" text="Edit" prefWidth="100" disable="true" 
                        style="-fx-background-color: #FF9800; -fx-text-fill: white;"/>
                <Button fx:id="deleteButton" text="Delete" prefWidth="100" disable="true" 
                        style="-fx-background-color: #D32F2F; -fx-text-fill: white;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="countLabel" text="Total: 0 suppliers" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
            </HBox>
            
        </VBox>
    </center>
    
    <!-- Bottom Status Bar -->
    <bottom>
        <HBox style="-fx-background-color: #f5f5f5; -fx-padding: 8;">
            <Label fx:id="statusLabel" text="Ready" style="-fx-font-size: 11px;"/>
        </HBox>
    </bottom>
    
</BorderPane>
