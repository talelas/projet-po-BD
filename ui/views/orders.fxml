<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ui.controllers.OrdersController" stylesheets="@../styles/styles.css">
    <top>
        <HBox style="-fx-background-color: #8E24AA; -fx-padding: 15;">
            <Label text="PURCHASE ORDERS" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="welcomeLabel" style="-fx-text-fill: white; -fx-font-size: 14px;"/>
            <Button fx:id="backButton" text="BACK" style="-fx-background-color: #6A1B9A; -fx-text-fill: white;">
                <HBox.margin><Insets left="15"/></HBox.margin>
            </Button>
        </HBox>
    </top>

    <center>
        <VBox spacing="12" style="-fx-padding: 16;">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="searchField" promptText="Search by supplier name..." prefWidth="220"/>
                <Button fx:id="searchButton" text="Search" styleClass="button"/>
                <Button fx:id="refreshButton" text="Refresh" styleClass="button"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="addOrderButton" text="New Order" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
                <Button fx:id="markReceivedButton" text="Mark Received" disable="true" style="-fx-background-color: #03A9F4; -fx-text-fill: white;"/>
            </HBox>

            <TabPane VBox.vgrow="ALWAYS">
                <Tab text="Pending" closable="false">
                    <TableView fx:id="pendingTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="pendIdColumn" text="ID" prefWidth="60"/>
                            <TableColumn fx:id="pendSuppColumn" text="Supplier" prefWidth="200"/>
                            <TableColumn fx:id="pendDateColumn" text="Order Date" prefWidth="120"/>
                            <TableColumn fx:id="pendETAColumn" text="ETA (days)" prefWidth="100"/>
                            <TableColumn fx:id="pendStatusColumn" text="Status" prefWidth="120"/>
                        </columns>
                    </TableView>
                </Tab>
                <Tab text="All Orders" closable="false">
                    <TableView fx:id="allTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="allIdColumn" text="ID" prefWidth="60"/>
                            <TableColumn fx:id="allSuppColumn" text="Supplier" prefWidth="200"/>
                            <TableColumn fx:id="allDateColumn" text="Order Date" prefWidth="120"/>
                            <TableColumn fx:id="allETAColumn" text="ETA (days)" prefWidth="100"/>
                            <TableColumn fx:id="allReceivedColumn" text="Received" prefWidth="100"/>
                            <TableColumn fx:id="allRecvDateColumn" text="Received Date" prefWidth="120"/>
                        </columns>
                    </TableView>
                </Tab>
            </TabPane>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Order Lines" style="-fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="addLineButton" text="Add Line" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
                <Button fx:id="removeLineButton" text="Remove Line" disable="true" style="-fx-background-color: #D32F2F; -fx-text-fill: white;"/>
            </HBox>
            <TableView fx:id="linesTable" prefHeight="180">
                <columns>
                    <TableColumn fx:id="lineProdColumn" text="Product" prefWidth="220"/>
                    <TableColumn fx:id="lineQtyColumn" text="Qty" prefWidth="80"/>
                    <TableColumn fx:id="linePriceColumn" text="Buy Price" prefWidth="120"/>
                </columns>
            </TableView>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Label fx:id="statusLabel" text="Ready" style="-fx-font-size: 11px;"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
