<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700" prefWidth="1000" style="-fx-background-color: #F5F5F5;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.controllers.ProductsController">
   
   <!-- Top Bar -->
   <top>
      <VBox>
         <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #0F7938; -fx-padding: 15;">
            <children>
               <Label text="PRODUCT MANAGEMENT" textFill="WHITE">
                  <font>
                     <Font name="System Bold" size="18.0" />
                  </font>
               </Label>
               <Label fx:id="welcomeLabel" text="Welcome, User" textFill="WHITE" HBox.hgrow="ALWAYS">
                  <font>
                     <Font size="14.0" />
                  </font>
                  <HBox.margin>
                     <Insets left="20.0" />
                  </HBox.margin>
               </Label>
               <Button fx:id="backButton" style="-fx-background-color: #455A64; -fx-text-fill: white; -fx-font-weight: bold;" text="← BACK" />
            </children>
         </HBox>
         
         <!-- Toolbar -->
         <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: white; -fx-padding: 15; -fx-border-color: #E0E0E0; -fx-border-width: 0 0 1 0;">
            <children>
               <TextField fx:id="searchField" promptText="Search products..." prefWidth="250" style="-fx-padding: 8;" />
               <Button fx:id="searchButton" style="-fx-background-color: #1976D2; -fx-text-fill: white; -fx-padding: 8 15;" text="🔍 Search" />
               <Label text=" " HBox.hgrow="ALWAYS" />
               <Button fx:id="refreshButton" style="-fx-background-color: #607D8B; -fx-text-fill: white; -fx-padding: 8 15;" text="🔄 Refresh" />
               <Button fx:id="addButton" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-padding: 8 15; -fx-font-weight: bold;" text="+ Add Product" />
               <Button fx:id="criticalStockButton" style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-padding: 8 15; -fx-font-weight: bold;" text="🚨 Critical Stock" />
            </children>
         </HBox>
      </VBox>
   </top>
   
   <!-- Center - Table -->
   <center>
      <VBox style="-fx-padding: 20;">
         <children>
            <TableView fx:id="productsTable" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="idColumn" prefWidth="60" text="ID" />
                  <TableColumn fx:id="nameColumn" prefWidth="200" text="Product Name" />
                  <TableColumn fx:id="priceColumn" prefWidth="100" text="Price (TND)" />
                  <TableColumn fx:id="quantityColumn" prefWidth="100" text="Quantity" />
                  <TableColumn fx:id="minQuantityColumn" prefWidth="120" text="Min Quantity" />
                  <TableColumn fx:id="categoryColumn" prefWidth="150" text="Category" />
                  <TableColumn fx:id="statusColumn" prefWidth="100" text="Status" />
               </columns>
            </TableView>
            
            <!-- Action Buttons -->
            <HBox alignment="CENTER" spacing="15" style="-fx-padding: 15 0 0 0;">
               <children>
                  <Button fx:id="editButton" disable="true" style="-fx-background-color: #1976D2; -fx-text-fill: white; -fx-padding: 10 30;" text="✏️ Edit" />
                  <Button fx:id="deleteButton" disable="true" style="-fx-background-color: #D32F2F; -fx-text-fill: white; -fx-padding: 10 30;" text="🗑️ Delete" />
               </children>
            </HBox>
         </children>
      </VBox>
   </center>
   
   <!-- Bottom Bar -->
   <bottom>
      <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: #455A64; -fx-padding: 10;">
         <children>
            <Label fx:id="statusLabel" text="Ready" textFill="WHITE">
               <font>
                  <Font size="12.0" />
               </font>
            </Label>
            <Label text=" " HBox.hgrow="ALWAYS" />
            <Label fx:id="countLabel" text="Total: 0 products" textFill="WHITE">
               <font>
                  <Font size="12.0" />
               </font>
            </Label>
         </children>
      </HBox>
   </bottom>
   
</BorderPane>
